# Choose: fallback | openai | openrouter | groq | gemini | ollama | lmstudio | custom
TUTOR_PROVIDER=fallback

# Required for remote providers; keep secrets in Render, never in browser code.
TUTOR_API_KEY=
TUTOR_MODEL=

# Optional. Overrides the provider preset and enables any reachable OpenAI-compatible endpoint.
TUTOR_BASE_URL=

# Optional tuning.
TUTOR_TEMPERATURE=0.25

# OpenRouter attribution headers are optional.
OPENROUTER_REFERER=
OPENROUTER_TITLE=NahaLabs AI Whiteboard Tutor

# For local/self-hosted deployments only:
# Ollama default: http://localhost:11434/v1
# LM Studio default: http://localhost:1234/v1
